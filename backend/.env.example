APP_NAME=doyoularp
DEBUG=false
PORT=8000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000

# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-cool-snowflake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Primary AI Provider: Groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Multi-Provider AI Fallback & Task Division (configure any or all)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Roast Intensity: 0 (factual) to 4 (nuclear), default 3
ROAST_INTENSITY=3

# Limits & Security
MAX_PDF_SIZE_BYTES=10485760
REQUEST_TIMEOUT_SECONDS=15
MAX_CONCURRENT_GITHUB_REQS=5
